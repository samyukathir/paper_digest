# Copy this file to .env and fill in real values. Never commit .env.

# Required — digest write-up
ANTHROPIC_API_KEY=

# Required — email delivery (use a Gmail "App Password", not your real password)
SMTP_USER=
SMTP_PASS=

# Required — where the digest is sent, and what it's sent from.
# Never committed to git; kept out of config.yaml on purpose.
EMAIL_TO=
EMAIL_FROM=

# Optional — raises Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=

# Optional but recommended — OpenAlex "polite pool" (higher rate limits)
OPENALEX_MAILTO=

# Optional — only needed if sources.nature.enabled = true in config.yaml
SPRINGER_NATURE_API_KEY=

# Optional — only needed if sources.sciencedirect.enabled = true in config.yaml
ELSEVIER_API_KEY=

# Optional — only needed if you wire up the Google Scholar / SerpApi fetcher yourself
SERPAPI_API_KEY=
